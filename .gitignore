!/package.json
!/run.py
!/pytest.ini
!/README.md
!/ARCHITECTURE.md
!/STATUS.md
!/AGENTS.md
!/LICENSE
!/Dashboard.md
!/chrysalis/
!/chrysalis/**
!/helpers/
!/helpers/**
!/hosts/
!/hosts/**
!/skills/
!/skills/**
!/_types/
!/_types/**
!/_templates/
!/_templates/**
!/contracts/
!/contracts/**
!/docs/
!/docs/**
!/tests/
!/tests/**
!/Development/
/Development/*
!/Development/README.md
!/Development/AGENT-WORKFLOW.md
!/Development/HANDOFF.md
!/Development/TESTING.md
!/Development/requirements.lock
!/Development/scripts/
!/Development/scripts/**
!/System/
/System/*
!/System/Runtime-Constitution.md
!/System/scripts/
!/System/scripts/**
!/System/_templates/
!/System/_templates/**
!/TaskNotes/
/TaskNotes/*
!/TaskNotes/Views/
!/TaskNotes/Views/**
!/Projects/
/Projects/*
!/Projects/README.md
!/Projects/_templates/
!/Projects/_templates/**
!/Slipbox/
/Slipbox/*
!/Slipbox/README.md
!/Slipbox/_templates/
!/Slipbox/_templates/**
!/Environments/
/Environments/*
!/Environments/README.md
!/Environments/_templates/
!/Environments/_templates/**
!/TaskNotes/Workflows/
/TaskNotes/Workflows/*
!/TaskNotes/Workflows/README.md
!/TaskNotes/Tasks/
/TaskNotes/Tasks/*
!/TaskNotes/Tasks/example-task.md
# Defense in depth for every allowlisted directory.
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/.venv*/
**/.backup/
**/.chrysalis/
*.pyc
*.env
*.token.json
*credentials*.json
*.db
*.sqlite*
*.log
*.tmp
*.bak
*.lock
!/Development/requirements.lock
Thumbs.db
.DS_Store
*(conflict*
