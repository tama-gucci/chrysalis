# =======================================================
# Chrysalis Zero-Leak Whitelist (Default-Deny) .gitignore
# =======================================================

# 1. DEFAULT-DENY: Ignore everything by default
/*

# 2. Root Open-Source Framework Files
!/.gitignore
!/.gitattributes
!/.editorconfig
!/requirements.txt
!/README.md
!/ARCHITECTURE.md
!/STATUS.md
!/LICENSE
!/Dashboard.md
!/AGENTS.md
!/bootstrap.sh
!/update.sh
!/update.py
!/mdbase.yaml
!/pytest.ini

# 2b. Whitelist Framework Documentation & Test Fixtures
!/docs/
!/docs/**
!/fixtures/
!/fixtures/**

# 3. Whitelist _types and contracts Directories
!/_types/
!/_types/**
!/contracts/
!/contracts/**
!/_contracts/
!/_contracts/**
!/_templates/
!/_templates/**
!/helpers/
!/helpers/**
helpers/**/__pycache__/
helpers/**/*.pyc

# 4. Whitelist System Architecture, Public Templates & Environment Tools ONLY
!/System/
/System/*
!/System/Runtime-Constitution.md
!/System/scripts/
!/System/scripts/**
!/System/Orchestrators/
!/System/Orchestrators/**
!/System/_templates/
!/System/_templates/**
!/System/Environment/
/System/Environment/*
!/System/Environment/_templates/
!/System/Environment/_templates/**
!/System/Environment/scripts/
!/System/Environment/scripts/**
!/System/Environment/Environment-Index.md

# 5. Whitelist Agent Skills Engine ONLY (Exclude backups)
!/.agent/
/.agent/*
!/.agent/skills.json
!/.agent/skills/
!/.agent/skills/**
.agent/skills/.backup/
/.agent/skills/.backup/
.agent/backup/
/.agent/backup/

# 6. Whitelist Development Sphere & Engineering Tooling
!/Development/
/Development/*
!/Development/Development-Constitution.md
!/Development/README.md
!/Development/requirements.lock
!/Development/TESTING.md
!/Development/ROADMAP.md
!/Development/AGENT-WORKFLOW.md
!/Development/HANDOFF.md
!/Development/WORKSTATION-SETUP.md
!/Development/BEGINNERS-GUIDE.md
!/Development/REVIEW-2026-09-15.md
!/Development/BACKGROUND-DEVELOPMENT.md
!/Development/BACKGROUND-DEVELOPMENT-REFERENCE.md
!/Development/BACKLOG.md
!/Development/FEEDBACK.md
!/Development/SPARK-INTEGRATION-ASSESSMENT.md
!/Development/_templates/
!/Development/_templates/**
!/Development/scripts/
!/Development/scripts/**
!/Development/skills/
!/Development/skills/**

# Private feedback stays local; only sanitized engineering summaries are public.
/Development/feedback/

# 7. Whitelist TaskNotes Views, Workflows, Templates & Example Task ONLY
!/TaskNotes/
/TaskNotes/*
!/TaskNotes/Views/
!/TaskNotes/Views/**
!/TaskNotes/Workflows/
!/TaskNotes/Workflows/**
!/TaskNotes/_templates/
!/TaskNotes/_templates/**
!/TaskNotes/Tasks/
/TaskNotes/Tasks/*
!/TaskNotes/Tasks/example-task.md
/TaskNotes/Archive/
/TaskNotes/Archive/**
/TaskNotes/Daily/
/TaskNotes/Daily/**

# Legacy / Runtime Vault chrysalis/ subfolder (quarantined personal substrates)
/chrysalis/
/chrysalis/*
/chrysalis/Tasks/*
/chrysalis/Archive/**
/chrysalis/Daily/**

# 8. Whitelist Public Project & Slipbox Templates/READMEs ONLY
!/Projects/
/Projects/*
!/Projects/README.md
!/Projects/_templates/
!/Projects/_templates/**

!/Slipbox/
/Slipbox/*
!/Slipbox/README.md
!/Slipbox/_templates/
!/Slipbox/_templates/**

# 9. Whitelist Obsidian Plugins Core & Assets ONLY (Deny all caches, runtimes, tokens)
!/.obsidian/
/.obsidian/*
!/.obsidian/app.json
!/.obsidian/appearance.json
!/.obsidian/community-plugins.json
!/.obsidian/core-plugins.json
!/.obsidian/plugins/
/.obsidian/plugins/*
!/.obsidian/plugins/*/
/.obsidian/plugins/**/data.json
/.obsidian/plugins/**/data/
/.obsidian/plugins/**/runs/
/.obsidian/plugins/**/cache.db
/.obsidian/plugins/**/storage/
/.obsidian/workspace*.json
/.obsidian/plugins/obsidian-git/obsidian_askpass.sh
!/.obsidian/plugins/**/main.js
!/.obsidian/plugins/**/manifest.json
!/.obsidian/plugins/**/styles.css
!/.obsidian/plugins/**/connector.js
!/.obsidian/plugins/**/sqlite3.wasm

# 10. Archived / Deprecated Application Substrates (Strictly Denied on Main)
/apps/
/apps/**


# 11. Catch-all: Explicitly Deny Secrets, OS Cruft, and Sync Conflicts Everywhere
*.env
*.token.json
*credentials*.json
*token*.json
*.db
*.sqlite
*.sqlite3
*.pyc
__pycache__/
.DS_Store
Thumbs.db
*(conflict*
* (conflict*
.trash/
Nexus/
/Nexus/
.conversations/
/.conversations/
.workspaces/
/.workspaces/
*.log
*.tmp
*.bak
*.swp
*.swo

# 12. Whitelist Framework Automated Test Suite
!/tests/
!/tests/**
tests/**/__pycache__/
tests/**/*.pyc


# Private installation metadata and deployment backups
.chrysalis/
