# =======================================================
# Chrysalis Zero-Leak Whitelist (Default-Deny) .gitignore
# =======================================================

# 1. DEFAULT-DENY: Ignore everything by default
/*

# 2. Root Open-Source Framework Files
!/.gitignore
!/README.md
!/LICENSE
!/Dashboard.md
!/AGENTS.md
!/bootstrap.sh
!/update.sh
!/update.py
!/mdbase.yaml

# 3. Whitelist _types Directory
!/_types/
!/_types/**

# 4. Whitelist System Architecture, Public Templates & Environment Tools ONLY
!/System/
/System/*
!/System/Runtime-Constitution.md
!/System/scripts/
!/System/scripts/**
!/System/Orchestrators/
!/System/Orchestrators/**
!/System/_templates/
!/System/_templates/**
!/System/Environment/
/System/Environment/*
!/System/Environment/_templates/
!/System/Environment/_templates/**
!/System/Environment/scripts/
!/System/Environment/scripts/**
!/System/Environment/Environment-Index.md

# 5. Whitelist Agent Skills Engine ONLY (Exclude backups)
!/.agent/
/.agent/*
!/.agent/skills.json
!/.agent/skills/
!/.agent/skills/**
.agent/skills/.backup/
/.agent/skills/.backup/
.agent/backup/
/.agent/backup/

# 6. Whitelist Development Sphere & Engineering Tooling
!/Development/
/Development/*
!/Development/Development-Constitution.md
!/Development/README.md
!/Development/ROADMAP.md
!/Development/_templates/
!/Development/_templates/**
!/Development/scripts/
!/Development/scripts/**
!/Development/skills/
!/Development/skills/**

# 7. Whitelist Chrysalis & Legacy TaskNotes Views, Workflows, Templates & Example Task ONLY
!/chrysalis/
/chrysalis/*
!/chrysalis/Views/
!/chrysalis/Views/**
!/chrysalis/Workflows/
!/chrysalis/Workflows/**
!/chrysalis/_templates/
!/chrysalis/_templates/**
!/chrysalis/Tasks/
/chrysalis/Tasks/*
!/chrysalis/Tasks/example-task.md
/chrysalis/Archive/
/chrysalis/Archive/**

# 8. Whitelist Public Project & Slipbox Templates/READMEs ONLY
!/Projects/
/Projects/*
!/Projects/README.md
!/Projects/_templates/
!/Projects/_templates/**

!/Slipbox/
/Slipbox/*
!/Slipbox/README.md
!/Slipbox/_templates/
!/Slipbox/_templates/**

# 9. Whitelist Obsidian Plugins Core & Assets ONLY (Deny all caches, runtimes, tokens)
!/.obsidian/
/.obsidian/*
!/.obsidian/app.json
!/.obsidian/appearance.json
!/.obsidian/community-plugins.json
!/.obsidian/core-plugins.json
!/.obsidian/plugins/
/.obsidian/plugins/*
!/.obsidian/plugins/*/
/.obsidian/plugins/**/data.json
/.obsidian/plugins/**/data/
/.obsidian/plugins/**/runs/
/.obsidian/plugins/**/cache.db
/.obsidian/plugins/**/storage/
/.obsidian/workspace*.json
/.obsidian/plugins/obsidian-git/obsidian_askpass.sh
!/.obsidian/plugins/obsidian-git/data.json
!/.obsidian/plugins/chrysalis-obsidian/data.json
!/.obsidian/plugins/tasknotes-workflows/data.json
!/.obsidian/plugins/various-complements/data.json
!/.obsidian/plugins/dataview/data.json
!/.obsidian/plugins/**/main.js
!/.obsidian/plugins/**/manifest.json
!/.obsidian/plugins/**/styles.css
!/.obsidian/plugins/**/connector.js
!/.obsidian/plugins/**/sqlite3.wasm

# 10. Whitelist Mobile Client & Ambient Gateway Application Substrates
!/apps/
/apps/*
!/apps/mobile/
/apps/mobile/.dart_tool/
/apps/mobile/.flutter-plugins
/apps/mobile/.flutter-plugins-dependencies
/apps/mobile/build/
/apps/mobile/.pub-cache/
/apps/mobile/.pub/
/apps/mobile/.idea/
/apps/mobile/**/*.iml
/apps/mobile/android/.gradle/
/apps/mobile/android/local.properties
/apps/mobile/android/**/build/
/apps/mobile/ios/Pods/
/apps/mobile/ios/.symlinks/
/apps/mobile/ios/Flutter/Flutter.framework
/apps/mobile/ios/Flutter/Flutter.podspec
/apps/mobile/ios/Flutter/Generated.xcconfig
/apps/mobile/ios/Flutter/flutter_export_environment.sh
/apps/mobile/ios/Flutter/ephemeral/
/apps/mobile/ios/Flutter/app.framework
/apps/mobile/linux/flutter/ephemeral/
/apps/mobile/windows/flutter/ephemeral/
/apps/mobile/macos/Flutter/ephemeral/
/apps/mobile/macos/Flutter/flutter_export_environment.sh
/apps/mobile/macos/Flutter/GeneratedPluginRegistrant.swift
!/apps/gateway/
/apps/gateway/.venv/
/apps/gateway/venv/
/apps/gateway/**/__pycache__/
/apps/gateway/**/*.pyc
/apps/gateway/.pytest_cache/

# 11. Catch-all: Explicitly Deny Secrets, OS Cruft, and Sync Conflicts Everywhere
*.env
*.token.json
*credentials*.json
*token*.json
*.db
*.sqlite
*.sqlite3
*.pyc
__pycache__/
.DS_Store
Thumbs.db
*(conflict*
* (conflict*
.trash/
Nexus/
/Nexus/
.conversations/
/.conversations/
.workspaces/
/.workspaces/
*.log
*.tmp
*.bak
*.swp
*.swo

# 12. Whitelist Framework Automated Test Suite
!/tests/
!/tests/**
tests/**/__pycache__/
tests/**/*.pyc

