# ==============================================================================
# Systemd User Unit for Ambient Chrysalis Gateway Daemon
# ==============================================================================
#
# Install Location:
#   ~/.config/systemd/user/chrysalis-gateway.service
#
# Management Commands:
#   systemctl --user daemon-reload
#   systemctl --user enable --now chrysalis-gateway.service
#   systemctl --user status chrysalis-gateway.service
#   journalctl --user -u chrysalis-gateway.service -f

[Unit]
Description=Ambient Chrysalis Gateway Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/GoogleDrive/chrysalis/apps/gateway
ExecStart=%h/GoogleDrive/chrysalis/apps/gateway/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=CHRYSALIS_GATEWAY_PORT=8765
Environment=CHRYSALIS_NODE_PROFILE=station-node
# Optional: Secure external tunnel access with an auth token
# Environment=CHRYSALIS_GATEWAY_TOKEN=your-secure-pre-shared-token

[Install]
WantedBy=default.target
