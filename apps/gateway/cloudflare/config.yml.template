# ==============================================================================
# Cloudflare Zero-Trust Tunnel Configuration for Ambient Chrysalis Gateway
# ==============================================================================
#
# Prerequisite:
#   1. Install cloudflared on your home server (e.g. station-node).
#   2. Authenticate: cloudflared tunnel login
#   3. Create tunnel: cloudflared tunnel create chrysalis
#   4. Replace <TUNNEL_UUID> with your tunnel UUID and save to ~/.cloudflared/config.yml
#
# Zero-Phone-Configuration Invariant:
#   Cloudflare Tunnel terminates TLS externally and routes requests to the local
#   FastAPI daemon over port 8765 (leaving port 8080 free for Obsidian TaskNotes).
#   The phone requires ZERO auxiliary VPN apps.

tunnel: <TUNNEL_UUID>
credentials-file: ~/.cloudflared/<TUNNEL_UUID>.json

ingress:
  # Route public HTTPS/WSS traffic to local gateway daemon
  - hostname: chrysalis.example.com
    service: http://localhost:8765
    originRequest:
      noTLSVerify: false
      connectTimeout: 30s

  # Catch-all 404 rule required by cloudflared
  - service: http_status:404
