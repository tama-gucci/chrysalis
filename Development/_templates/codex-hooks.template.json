{
  "description": "Read shared Chrysalis engineering context at session start or resume.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/Development/scripts/agent_context.py\" codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
