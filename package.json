{
  "name": "chrysalis",
  "version": "2.0.0",
  "description": "Pi skills and tools for a portable Markdown knowledge and daily-work vault",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "obsidian",
    "tasknotes"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions/chrysalis.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.4 <2",
    "typebox": ">=1.3.27 <2"
  },
  "files": [
    "src",
    "extensions",
    "resources",
    "skills",
    "contracts",
    "docs",
    "README.md",
    "ARCHITECTURE.md",
    "STATUS.md",
    "CHANGELOG.md",
    "LICENSE",
    "Development",
    "tests",
    "tsconfig.json",
    "AGENTS.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "@modelcontextprotocol/sdk": "1.32.1",
    "google-auth-library": "10.9.1",
    "yaml": "2.9.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@js-temporal/polyfill": "0.5.1",
    "pdfjs-dist": "6.4.299",
    "@thednp/dommatrix": "3.1.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.6.4",
    "@tasknotes/model": "0.3.0-rc.9",
    "prettier": "3.6.2",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "typebox": "1.3.27"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "node Development/scripts/check.mjs"
  }
}
