{
  "name": "chrysalis",
  "version": "2.0.0",
  "description": "Portable Pi assistant for planning, learning, research and reviewed Markdown vault work",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "obsidian",
    "tasknotes"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions/bootstrap-guard.mjs",
      "./extensions/chrysalis.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2",
    "@sinclair/typebox": "*",
    "typebox": ">=1.3.27 <2"
  },
  "files": [
    "src",
    "extensions",
    "resources",
    "skills",
    "contracts",
    "docs",
    "README.md",
    "ARCHITECTURE.md",
    "STATUS.md",
    "CHANGELOG.md",
    "LICENSE",
    "Development",
    "tests",
    "tsconfig.json",
    "AGENTS.md",
    "NOTICE.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@aliou/pi-guardrails": "0.19.0",
    "@js-temporal/polyfill": "0.5.1",
    "@maplezzk/pi-interactive-subagents": "3.16.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@thednp/dommatrix": "3.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.3",
    "google-auth-library": "10.9.1",
    "grok-mermaid": "0.2.3",
    "jiti": "2.7.0",
    "pdfjs-dist": "6.4.299",
    "pi-blackhole": "0.5.12",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@sinclair/typebox": "0.34.49",
    "@tasknotes/model": "0.3.0-rc.9",
    "@types/node": "26.6.4",
    "prettier": "3.6.2",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "node Development/scripts/check.mjs"
  }
}
